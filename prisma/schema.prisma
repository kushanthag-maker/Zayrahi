// LOCAL DEVELOPMENT: SQLite (madi config nathi bawa kilino runtime ekedi wada karanawa)
// Vercel eke deploy karanna kalin README eke "Vercel Deploy" section eka balanna -
// eke schema.postgres.prisma file eka use karanna kiyala thiyenawa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         String    @default("user") // "user" | "admin"
  coins        Int       @default(0)
  apiKey       String    @unique
  createdAt    DateTime  @default(now())
  orders       Order[]
  txns         CoinTransaction[]
}

model Order {
  id         Int      @id @default(autoincrement())
  userId     Int
  serviceId  String
  serviceName String
  quantity   Int
  priceLkr   Float
  status     String   @default("processing")
  providerOrderId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int      // + add, - spend
  reason    String
  byAdmin   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
