# ---- Database (Vercel eke PostgreSQL free ekak ganna: https://neon.tech) ----
DATABASE_URL="postgresql://user:password@host:5432/zayra?sslmode=require"

# ---- JWT secret (random string ekak denna) ----
JWT_SECRET="change-this-to-a-long-random-secret"

# ---- Admin seed user ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@1234"

# ---- Social media API provider (SMM panel / API provider) ----
# Meka thanak thana configure karanna. Key haraha thamai orders forward wenne.
PROVIDER_API_URL=""
PROVIDER_API_KEY=""

# ---- Platform API keys (ayeth env walata witharak) ----
FACEBOOK_API_KEY=""
INSTAGRAM_API_KEY=""
TIKTOK_API_KEY=""
YOUTUBE_API_KEY=""
X_API_KEY=""
TELEGRAM_BOT_TOKEN=""
